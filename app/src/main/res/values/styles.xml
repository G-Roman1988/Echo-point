<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GlobalButtonStyle" parent="Widget.Material3.Button">
        <item name="textAllCaps">false</item>
        <item name="android:backgroundTint">@color/dark_green</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomTextViewStyle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomAppBarStyle" parent="Widget.Material3.AppBarLayout">
    <item name="android:background">@color/background_color_appbar</item>
    </style>

    <style name="CustomToolbarStyle" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background_color_appbar</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>